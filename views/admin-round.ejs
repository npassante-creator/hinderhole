<%- include('partials/head', { title: 'Round ' + round.round_number + ' - Commissioner', wide: true }) %>


  <header class="pagehead">
    <p class="pagehead__crumbs">
      <a href="/admin">Commissioner</a> <span aria-hidden="true">/</span>
      Round <%= String(round.round_number).padStart(2, '0') %> &middot; <%= round.status %><% if (round.on_hold) { %> &middot; on hold<% } %>
    </p>
    <h1 class="pagehead__title"><%= round.title %></h1>
  </header>

  <main class="panel">

    <% if (error) { %><p class="notice notice--bad"><%= error %></p><% } %>
    <% if (notice) { %><p class="notice notice--good"><%= notice %></p><% } %>

    <dl class="facts">
      <div class="facts__row"><dt>Songs due</dt><dd><%= submitBy || 'unset' %></dd></div>
      <div class="facts__row"><dt>Votes due</dt><dd><%= voteBy || 'unset' %></dd></div>
      <div class="facts__row"><dt>Still missing</dt><dd><%= missing %></dd></div>
      <div class="facts__row"><dt>Not voted</dt><dd><%= notVoted %> none, <%= partial %> partway</dd></div>
    </dl>

    <h2 class="rack__heading">Give them more time</h2>

    <div class="extend">
      <form class="extendform" method="post" action="/admin/round/<%= round.id %>/extend">
        <label class="ctl__field">
          <span class="ctl__label">How much</span>
          <select class="field__input" name="by">
            <% bumps.forEach(function (b) { %>
              <option value="<%= b.key %>" <%= b.key === '1d' ? 'selected' : '' %>>+<%= b.label %></option>
            <% }) %>
          </select>
        </label>
        <fieldset class="extendform__which">
          <legend class="ctl__label">Which deadline</legend>
          <label class="extendform__opt">
            <input type="radio" name="which" value="submit" <%= round.status === 'voting' ? '' : 'checked' %>>
            <span>Songs <span class="extendform__hint">votes move too, so listening stays five days</span></span>
          </label>
          <label class="extendform__opt">
            <input type="radio" name="which" value="vote" <%= round.status === 'voting' ? 'checked' : '' %>>
            <span>Votes only</span>
          </label>
        </fieldset>
        <input type="hidden" name="shift" value="1">
        <button class="button" type="submit">Apply</button>
      </form>

      <div class="setting">
        <span class="setting__text">
          <span class="setting__name">Stop the clock</span>
          <span class="setting__sub">A held round sits where it is until you move it by hand. The rest of the season carries on.</span>
        </span>
        <form method="post" action="/admin/round/<%= round.id %>/hold">
          <button class="chip <%= round.on_hold ? 'chip--on' : '' %>" type="submit">
            <%= round.on_hold ? 'on hold' : 'hold this round' %>
          </button>
        </form>
      </div>
    </div>

    <% if (typeof clashes !== 'undefined' && clashes.length) { %>
      <h2 class="rack__heading">Possible duplicates</h2>
      <div class="echo">
        <span class="echo__label">Two people, one song</span>
        <ul class="echo__list">
          <% clashes.forEach(function (c) { %>
            <% if (c.hidden) { %>
              <li>
                <%= c.n %> possible duplicate<%= c.n === 1 ? "" : "s" %> in this round.
                <a class="echo__reveal" href="/admin/round/<%= round.id %>?dupes=1">Show who</a>
              </li>
            <% } else { %>
            <li class="echo__clash">
              <span class="echo__how"><%= c.how %></span>
              <span class="echo__pair">
                <span class="echo__side <% if (c.a_first) { %>echo__side--first<% } else { %>echo__side--second<% } %>">
                  <strong><%= c.a_player %></strong>
                  <span class="echo__song"><%= c.a_title %></span>
                  <span class="echo__ts"><%= c.a_submitted_at_fmt %> &middot; <%= c.a_first ? "submitted first" : "needs to change" %></span>
                </span>
                <span class="echo__side <% if (!c.a_first) { %>echo__side--first<% } else { %>echo__side--second<% } %>">
                  <strong><%= c.b_player %></strong>
                  <span class="echo__song"><%= c.b_title %></span>
                  <span class="echo__ts"><%= c.b_submitted_at_fmt %> &middot; <% if (!c.a_first) { %>submitted first<% } else { %>needs to change<% } %></span>
                </span>
              </span>
            </li>
            <% } %>
          <% }) %>
        </ul>
        Nobody else can see this. Matching is fuzzy, so check before you say anything.
      </div>
    <% } %>

    <details class="drawer">
      <summary class="drawer__summary">Adjust someone's points</summary>

      <% if (typeof adjustments !== 'undefined' && adjustments.length) { %>
        <ul class="ledger">
          <% adjustments.forEach(function (a) { %>
            <li class="ledger__row">
              <span class="ledger__when"><%= a.points > 0 ? '+' : '' %><%= a.points %></span>
              <span class="ledger__what">
                <%= a.name %> &middot; <%= a.reason %>
                <% if (!a.round_id) { %><span class="tag">season</span><% } %>
              </span>
              <span class="ledger__who">
                <form method="post" action="/admin/adjust/<%= a.id %>/remove"
                      onsubmit="return confirm('Undo this adjustment?')">
                  <button class="chip chip--danger" type="submit">undo</button>
                </form>
              </span>
            </li>
          <% }) %>
        </ul>
      <% } %>

      <form class="strip strip--form" method="post"
            action="/admin/round/<%= round.id %>/adjust">
        <label class="field">
          <span class="field__label">Player</span>
          <select class="field__input" name="player_id" required>
            <option value="">Choose a player</option>
            <% people.forEach(function (p) { %>
              <option value="<%= p.id %>"><%= p.name %></option>
            <% }) %>
          </select>
        </label>
        <label class="field">
          <span class="field__label">Points (negative to take away)</span>
          <input class="field__input" type="number" name="points"
                 step="1" placeholder="-5" required>
        </label>
        <label class="field">
          <span class="field__label">Reason (everyone sees this)</span>
          <input class="field__input" type="text" name="reason"
                 maxlength="200" placeholder="Song did not fit the category" required>
        </label>
        <label class="field">
          <span class="field__label">Applies to</span>
          <select class="field__input" name="scope">
            <option value="round">This round</option>
            <option value="season">The season total</option>
          </select>
        </label>
        <button class="button" type="submit">Apply</button>
      </form>

      <p class="fineprint">
        Shown on the results page with the reason attached. Nothing here
        touches anyone's votes, so the arithmetic still adds up.
      </p>
    </details>

    <h2 class="rack__heading">Who is in</h2>

    <% if (!showSongs) { %>
      <p class="moves">
        <a class="chip" href="/admin/round/<%= round.id %>?songs=1">Show the songs</a>
      </p>
      <p class="fineprint">
        Hidden so you can run the round without seeing what everyone
        picked. Everything else here works without them.
      </p>
    <% } else if (round.status !== 'revealed') { %>
      <p class="moves">
        <a class="chip chip--on" href="/admin/round/<%= round.id %>">Hide the songs again</a>
      </p>
    <% } %>

    <div class="tablewrap">
    <table class="grid">
      <thead>
        <tr><th>Player</th><th>Song</th><th>Voted</th><th>Extension</th></tr>
      </thead>
      <tbody>
        <% people.forEach(function (p) { %>
          <tr class="<%= p.submission_id ? '' : 'grid__row--missing' %>">
            <td>
              <% if (showSongs) { %>
                <details class="grid__who">
                  <summary class="grid__who-sum">reveal</summary>
                  <span class="grid__name"><%= p.name %></span>
                  <% if (p.is_late) { %><span class="tag tag--late">late</span><% } %>
                </details>
              <% } else { %>
                <span class="grid__name"><%= p.name %></span>
                <% if (p.is_late) { %><span class="tag tag--late">late</span><% } %>
              <% } %>
            </td>
            <td>
              <% if (p.submission_id && !showSongs) { %>
                <span class="grid__sub">in</span>
              <% } else if (p.submission_id) { %>
                <span class="grid__song"><%= p.title %></span>
                <span class="grid__sub"><%= p.artist || 'unknown' %> &middot; <%= p.submittedAt %></span>
              <% } else { %>
                <span class="grid__sub">nothing yet</span>
              <% } %>
            </td>
            <td class="grid__spent">
              <% if (round.status === 'draft' || round.status === 'submitting') { %>
                <span class="grid__sub">&mdash;</span>
              <% } else if (!p.eligible) { %>
                <span class="grid__sub">not eligible</span>
              <% } else if (p.spent >= budget) { %>
                <span class="grid__done"><%= p.spent %>/<%= budget %></span>
              <% } else { %>
                <span class="grid__owed"><%= p.spent %>/<%= budget %></span>
              <% } %>
            </td>
            <td>
              <form method="post" action="/admin/round/<%= round.id %>/waiver">
                <input type="hidden" name="player_id" value="<%= p.id %>">
                <% if (p.has_waiver) { %>
                  <input type="hidden" name="revoke" value="1">
                  <button class="chip chip--on" type="submit">granted</button>
                <% } else { %>
                  <button class="chip" type="submit">grant</button>
                <% } %>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </div>

    <p class="fineprint">
      An extension lets someone vote this round even though their song was
      late or never arrived. It does not change their song.
    </p>

    <details class="drawer">
      <summary class="drawer__summary">Enter a song for someone</summary>
      <form class="strip strip--form" method="post" action="/admin/round/<%= round.id %>/submit-for">
        <label class="field">
          <span class="field__label">Player</span>
          <select class="field__input" name="player_id" required>
            <option value="">Choose a player</option>
            <% people.forEach(function (p) { %>
              <option value="<%= p.id %>"><%= p.name %><%= p.submission_id ? ' (replaces current)' : '' %></option>
            <% }) %>
          </select>
        </label>
        <label class="field">
          <span class="field__label">Link they sent you</span>
          <input class="field__input" type="url" name="url" placeholder="https://youtu.be/..." required>
        </label>
        <button class="button" type="submit">Enter song</button>
      </form>
      <p class="fineprint">
        For people who email you a song instead of using the site. Entered
        this way it is never marked late.
      </p>
    </details>

    <details class="drawer">
      <summary class="drawer__summary">Change deadlines or title</summary>
      <form class="strip strip--form" method="post" action="/admin/round/<%= round.id %>/deadlines">
        <label class="field">
          <span class="field__label">Title</span>
          <input class="field__input" type="text" name="title" value="<%= round.title %>">
        </label>
        <label class="field">
          <span class="field__label">What counts (shown to everyone under the title)</span>
          <textarea class="field__input field__input--area" name="description" rows="3"
                    placeholder="Instrumentals count. Live versions do not. Argue with me."><%= round.description || '' %></textarea>
        </label>
        <label class="field">
          <span class="field__label">Songs due (Central)</span>
          <input class="field__input" type="datetime-local" name="submit_deadline">
        </label>
        <label class="field">
          <span class="field__label">Votes due (Central)</span>
          <input class="field__input" type="datetime-local" name="vote_deadline">
        </label>
        <button class="button" type="submit">Save round</button>
      </form>
      <p class="fineprint">
        Leave a date blank to keep it as it is. Clearing the caption and
        saving removes it.
      </p>
    </details>

  </main>

<%- include('partials/foot') %>
