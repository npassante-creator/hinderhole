<%- include('partials/head', { title: 'My picks - Holy Hinder Hole Sound Society' }) %>

  <header class="bar">
    <a class="bar__back" href="/">All rounds</a>
    <a class="bar__back" href="/upcoming">Coming up</a>
    <span class="bar__name"><%= player.name %></span>
  </header>

  <header class="marquee marquee--small">
    <p class="marquee__eyebrow"><%= player.name %></p>
    <h1 class="marquee__title"><span>My picks</span></h1>
  </header>

  <main class="panel">

    <% if (typeof error !== 'undefined' && error) { %>
      <p class="notice notice--bad"><%= error %></p>
    <% } %>
    <% if (typeof notice !== 'undefined' && notice) { %>
      <p class="notice notice--good"><%= notice %></p>
    <% } %>

    <details class="drawer">
      <summary class="drawer__summary">Change what people call you</summary>
      <form class="strip strip--form" method="post" action="/me/name">
        <label class="field">
          <span class="field__label">Your name in the league</span>
          <input class="field__input" type="text" name="name" maxlength="40"
                 value="<%= player.name %>" required>
        </label>
        <button class="button" type="submit">Save</button>
      </form>
      <p class="fineprint">
        This is what shows next to your songs when a round is revealed, and
        on the standings. Change it whenever. Your email never shows to
        anyone.
      </p>
    </details>


    <dl class="facts">
      <div class="facts__row"><dt>Points earned</dt><dd><%= total %></dd></div>
      <div class="facts__row"><dt>Rounds scored</dt><dd><%= played %></dd></div>
      <div class="facts__row"><dt>Rounds won</dt><dd><%= wins %></dd></div>
      <% if (best) { %>
        <div class="facts__row">
          <dt>Best showing</dt>
          <dd><%= best.title %>, <%= best.points %></dd>
        </div>
      <% } %>
    </dl>

    <% if (typeof savedByRound !== 'undefined' && savedByRound.length) { %>
      <h2 class="rack__heading">Saved for later</h2>
      <% savedByRound.forEach(function (g) { %>
        <p class="saved__round">
          Round <%= String(g.round_number).padStart(2, '0') %> &middot;
          <%= g.category %>
          <% if (g.status === 'submitting') { %>
            <span class="tag tag--gave">open now</span>
          <% } %>
        </p>
        <ul class="shortlist__items">
          <% g.items.forEach(function (c) { %>
            <li class="cand">
              <% if (c.thumbnail_url) { %>
                <img class="cand__art" src="<%= c.thumbnail_url %>" alt="" loading="lazy">
              <% } %>
              <div class="cand__body">
                <p class="cand__title"><%= c.title || 'Untitled' %></p>
                <p class="cand__artist"><%= c.artist || 'Unknown artist' %></p>
                <% if (c.note) { %><p class="cand__note"><%= c.note %></p><% } %>
              </div>
              <div class="cand__acts">
                <% if (g.status === 'submitting') { %>
                  <form method="post" action="/shortlist/item/<%= c.id %>/use">
                    <button class="chip chip--on" type="submit">use this</button>
                  </form>
                <% } %>
                <form method="post" action="/shortlist/item/<%= c.id %>/remove">
                  <button class="chip chip--danger" type="submit">drop</button>
                </form>
              </div>
            </li>
          <% }) %>
        </ul>
      <% }) %>
      <p class="fineprint">
        Only you can see these. Add more from
        <a href="/upcoming">Coming up</a>.
      </p>
    <% } else { %>
      <p class="fineprint">
        Heard something that would suit a later round? Save it from
        <a href="/upcoming">Coming up</a> and it will be waiting when that
        week arrives.
      </p>
    <% } %>

    <h2 class="rack__heading">Every round</h2>

    <ol class="results">
      <% picks.forEach(function (p) { %>
        <li class="result">

          <div class="result__head">
            <span class="result__place">
              Round <%= String(p.round_number).padStart(2, '0') %>
            </span>
            <% if (p.points !== null) { %>
              <span class="result__score">
                <strong><%= p.points %></strong>
                <span class="result__backers">from <%= p.backers %></span>
              </span>
            <% } else { %>
              <span class="result__backers"><%= p.status %></span>
            <% } %>
          </div>

          <p class="idea__by"><%= p.category %></p>

          <% if (p.id) { %>
            <h2 class="result__title"><%= p.title %></h2>
            <p class="result__artist"><%= p.artist || 'Unknown artist' %></p>
            <p class="result__by">
              <% if (p.place) { %>
                <span class="tag tag--gave"><%= p.place.place %> of <%= p.place.field %></span>
              <% } %>
              <% if (p.is_late) { %><span class="tag tag--late">late</span><% } %>
              <a href="<%= p.source_url %>" target="_blank" rel="noopener">open</a>
            </p>
            <% if (p.note) { %>
              <blockquote class="result__note"><%= p.note %></blockquote>
            <% } %>
          <% } else { %>
            <p class="card__mine">
              <% if (p.status === 'submitting') { %>
                Nothing picked yet. <a href="/round/<%= p.round_id %>">Pick one</a>.
              <% } else { %>
                You sat this one out.
              <% } %>
            </p>
          <% } %>

        </li>
      <% }) %>
    </ol>

  </main>

<%- include('partials/foot') %>
