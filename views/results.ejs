<%- include('partials/head', { title: 'Results - ' + round.title }) %>

  <header class="bar">
    <a class="bar__back" href="/">All rounds</a>
    <a class="bar__back" href="/standings">Standings</a>
    <span class="bar__name"><%= player.name %></span>
  </header>

  <header class="marquee marquee--small">
    <p class="marquee__eyebrow">Round <%= String(round.round_number).padStart(2, '0') %> &middot; results</p>
    <h1 class="marquee__title"><span><%= round.title %></span></h1>
    <% if (round.description) { %>
      <p class="marquee__sub"><%= round.description %></p>
    <% } %>
  </header>

  <main class="panel">

    <% if (winner) { %>
      <div class="crown">
        <p class="crown__label">Took the round</p>
        <p class="crown__song"><%= winner.title %></p>
        <p class="crown__who"><%= winner.submitter %> &middot; <%= winner.points %> points</p>
      </div>
    <% } %>

    <dl class="facts">
      <div class="facts__row">
        <dt>Voted</dt>
        <dd><%= turnout.voted %> of <%= turnout.roster %></dd>
      </div>
      <div class="facts__row">
        <dt>Points cast</dt>
        <dd><%= turnout.cast %></dd>
      </div>
      <div class="facts__row">
        <dt>Songs</dt>
        <dd><%= songs.length %></dd>
      </div>
    </dl>

    <div class="queuebar">
      <button class="queuebar__toggle" type="button">Play all</button>
      <span class="queuebar__transport" hidden>
        <button class="queuebar__btn" type="button" data-act="prev" aria-label="Previous song">&#9664;&#9664;</button>
        <button class="queuebar__btn" type="button" data-act="playpause" aria-label="Pause">&#10074;&#10074;</button>
        <button class="queuebar__btn" type="button" data-act="next" aria-label="Next song">&#9654;&#9654;</button>
      </span>
      <span class="queuebar__status"></span>
    </div>

    <ol class="results">
      <% songs.forEach(function (s) { %>
        <li class="result <%= s.place === 1 ? 'result--top' : '' %> <%= s.is_mine ? 'result--mine' : '' %>">

          <div class="result__head">
            <span class="result__place"><%= s.place %></span>
            <span class="result__score">
              <strong><%= s.points %></strong>
              <span class="result__backers">from <%= s.backers %></span>
            </span>
          </div>

          <h2 class="result__title"><%= s.title %></h2>
          <p class="result__artist"><%= s.artist || 'Unknown artist' %></p>

          <% if (s.adjustment) { %>
            <p class="result__adjust">
              <%= s.adjustment > 0 ? "+" : "" %><%= s.adjustment %>
              from the commissioner:
              <%= s.adjust_reasons.join("; ") %>
            </p>
          <% } %>

          <% if (s.penalty) { %>
            <p class="result__penalty">
              <%= s.raw_points %> earned, <%= s.penalty %> deducted for
              <%= s.penalty %> unspent vote<%= s.penalty === 1 ? "" : "s" %>
            </p>
          <% } %>

          <p class="result__by">
            <span class="result__submitter"><%= s.submitter %></span>
            <% if (s.is_mine) { %><span class="tag">you</span><% } %>
            <% if (s.is_late) { %><span class="tag tag--late">late</span><% } %>
            <% if (s.my_points > 0) { %>
              <span class="tag tag--gave">you gave <%= s.my_points %></span>
            <% } %>
          </p>

          <%- include('partials/player', { sub: s }) %>

          <% if (s.note) { %>
            <blockquote class="result__note">
              <%= s.note %>
              <cite>&mdash; <%= s.submitter %></cite>
            </blockquote>
          <% } %>

          <% if (s.comments.length) { %>
            <ul class="chatter">
              <% s.comments.forEach(function (c) { %>
                <li class="chatter__line" data-comment-id="<%= c.id %>">
                  <div class="chatter__top">
                    <span class="chatter__who"><%= c.author %></span>
                    <span class="chatter__body"><%= c.body %></span>
                  </div>
                  <% if (c.replies.length) { %>
                    <ul class="chatter chatter--replies">
                      <% c.replies.forEach(function (r) { %>
                        <li class="chatter__line chatter__line--reply" data-reply-id="<%= r.id %>">
                          <span class="chatter__who"><%= r.author %></span>
                          <span class="chatter__body"><%= r.body %></span>
                        </li>
                      <% }) %>
                    </ul>
                  <% } %>
                  <div class="reply-thread" data-comment="<%= c.id %>" data-round="<%= round.id %>">
                    <button class="reply-toggle" type="button">&#8629; Reply</button>
                    <form class="reply-form" hidden>
                      <input class="reply-input" type="text" maxlength="500" placeholder="Add a reply&hellip;" autocomplete="off">
                      <button class="chip reply-send" type="submit">Send</button>
                    </form>
                  </div>
                </li>
              <% }) %>
            </ul>
          <% } %>

        </li>
      <% }) %>
    </ol>

    <div class="takeaway">
      <h2 class="rack__heading">Take it with you</h2>
      <p class="moves">
        <a class="chip" href="/round/<%= round.id %>/youtube" target="_blank" rel="noopener">YouTube playlist</a>
        <a class="chip" href="/round/<%= round.id %>/export.txt">Text list</a>
        <a class="chip" href="/round/<%= round.id %>/export.csv">CSV</a>
        <a class="chip" href="/round/<%= round.id %>/export.m3u">M3U</a>
      </p>
      <p class="fineprint">
        The YouTube link opens every song in this round as one playlist.
      </p>
    </div>

    <p class="fineprint">
      Comments were anonymous during voting. Authors and replies are visible here.
    </p>

  </main>

<script>
(function () {
  function esc(s) {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
            .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  }

  document.querySelectorAll('.reply-thread').forEach(function (thread) {
    var toggle    = thread.querySelector('.reply-toggle');
    var form      = thread.querySelector('.reply-form');
    var input     = thread.querySelector('.reply-input');
    var commentId = thread.dataset.comment;
    var roundId   = thread.dataset.round;

    toggle.addEventListener('click', function () {
      form.hidden = !form.hidden;
      if (!form.hidden) { input.focus(); }
    });

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      var body = input.value.trim();
      if (!body) return;
      toggle.disabled = true;

      try {
        var res  = await fetch('/round/' + roundId + '/reply', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ comment_id: commentId, body: body }),
        });
        var data = await res.json();
        if (!data.ok) { alert(data.error); return; }

        var li   = thread.closest('.chatter__line');
        var list = li.querySelector('.chatter--replies');
        if (!list) {
          list = document.createElement('ul');
          list.className = 'chatter chatter--replies';
          li.insertBefore(list, thread);
        }
        var item = document.createElement('li');
        item.className       = 'chatter__line chatter__line--reply';
        item.dataset.replyId = data.reply.id;
        item.innerHTML =
          '<span class="chatter__who">'  + esc(data.reply.author) + '</span>' +
          '<span class="chatter__body">' + esc(data.reply.body)   + '</span>';
        list.appendChild(item);

        input.value = '';
        form.hidden = true;
      } catch (err) {
        alert('Could not post reply. Try again.');
      } finally {
        toggle.disabled = false;
      }
    });
  });
}());
</script>
<%- include('partials/foot') %>
